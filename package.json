{
  "name": "lsegov-portal",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "build:kiosk": "node scripts/build.mjs --kiosk",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "db:import": "node --experimental-strip-types --env-file-if-exists=.env scripts/db.mjs import",
    "db:export": "node --experimental-strip-types --env-file-if-exists=.env scripts/db.mjs export",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/db.mjs migrate",
    "admin": "node --experimental-strip-types --env-file-if-exists=.env scripts/admin.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
