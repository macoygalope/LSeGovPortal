---
// Admin dashboard. Only `npm run admin` serves it (scripts/admin.mjs injects
// the route, see src/lib/admin-integration.ts): it writes to the local
// database, so it is in no build. Client-side: admin.js signs in by citizen ID
// (checked against the site_admins whitelist) and talks to the admin API
// (src/lib/admin-api.ts) with the session it gets back.
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/inter/latin-800.css";
import "@fontsource/merriweather/latin-700.css";
import "../styles/global.css";
import I18n from "../components/I18n.astro";
import LangBootstrap from "../components/LangBootstrap.astro";
import LanguageSelect from "../components/LanguageSelect.astro";
import { i18nAttr, t, type MessageKey } from "../lib/i18n";
import { LABELS } from "../lib/sections";
import { withBase } from "../lib/url";

const home = withBase("/");

// Attributes for a translatable placeholder / tooltip / aria-label.
const placeholder = (key: MessageKey) => ({ placeholder: t(key), ...i18nAttr({ placeholder: key }) });
const ariaLabel = (key: MessageKey) => ({ "aria-label": t(key), ...i18nAttr({ "aria-label": key }) });
---

<!doctype html>
<html lang="fil">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Los Santos eGov — Dashboard</title>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <LangBootstrap />
  </head>
<body class="admin-body">
  <header class="admin-header">
    <div class="container header-inner">
      <a class="brand" href={home}>
        <span class="brand-seal">LS</span>
        <span><strong>Los Santos eGov</strong><I18n as="small" k="admin.brandSub" /></span>
      </a>
      <a class="button button-secondary button-small" href={home}><I18n k="admin.viewSite" /></a>
    </div>
  </header>

  <main class="container admin-main">
    <section class="admin-login card" id="loginPanel">
      <I18n as="span" class="eyebrow" k="admin.login.eyebrow" />
      <h1>Admin Dashboard</h1>
      <I18n as="p" k="admin.login.intro" />
      <form id="loginForm" class="admin-login-form">
        <label>
          <I18n k="admin.login.citizenId" />
          <input
            id="citizenIdInput"
            type="text"
            maxlength="64"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            required
            {...placeholder("admin.login.citizenIdPlaceholder")}
          />
        </label>
        <button class="button button-primary" id="loginButton" type="submit"><I18n k="admin.login.submit" /></button>
      </form>
      <p class="helper-text" id="loginStatus" role="status" hidden></p>
      <I18n as="p" class="helper-text" k="admin.login.helper" />
    </section>

    <section class="admin-dashboard hidden" id="dashboard">
      <div class="admin-title-row">
        <div>
          <I18n as="span" class="eyebrow" k="admin.dash.eyebrow" />
          <h1>Los Santos eGov Dashboard</h1>
          <I18n as="p" k="admin.dash.intro" />
          <p class="admin-who" id="adminWho"></p>
        </div>
        <button class="button button-danger button-small" id="logoutButton" type="button"><I18n k="admin.logout" /></button>
      </div>

      <p class="admin-notice" role="note">
        <I18n k="admin.rebuild.note" /> <code>npm run build:kiosk</code>
      </p>

      <div class="admin-layout">
        <aside class="admin-sidebar card">
          <button class="admin-tab active" data-section="Forms"><I18n k={LABELS.Forms.plural} /></button>
          <button class="admin-tab" data-section="Announcements"><I18n k={LABELS.Announcements.plural} /></button>
          <button class="admin-tab" data-section="ExecutiveOrders"><I18n k={LABELS.ExecutiveOrders.plural} /></button>
          <button class="admin-tab" data-section="Memorandums"><I18n k={LABELS.Memorandums.plural} /></button>
          <button class="admin-tab" data-section="Resolutions"><I18n k={LABELS.Resolutions.plural} /></button>
          <button class="admin-tab settings-tab" data-section="Settings"><I18n k="admin.tab.Settings" /></button>
        </aside>

        <div class="admin-content">
          <section class="card admin-editor" id="entryEditor">
            <div class="admin-section-heading">
              <div>
                <span class="eyebrow" id="editorEyebrow">{t(LABELS.Forms.plural)}</span>
                <h2 id="editorTitle">{t("admin.editor.new")}</h2>
              </div>
              <button class="button button-secondary button-small hidden" id="cancelEditButton" type="button"><I18n k="admin.editor.cancel" /></button>
            </div>

            <form id="entryForm" class="entry-form">
              <input type="hidden" id="entryId" />

              <label id="titleFieldGroup">
                <I18n k="admin.field.title" />
                <input id="titleInput" type="text" maxlength="180" required />
              </label>

              <section id="memorandumFieldsGroup" class="memorandum-admin-fields hidden" aria-labelledby="memorandumFieldsTitle">
                <div class="admin-subsection-heading">
                  <div>
                    <I18n as="span" class="eyebrow" k="admin.memo.eyebrow" />
                    <I18n as="h3" id="memorandumFieldsTitle" k="admin.memo.title" />
                  </div>
                  <I18n as="p" k="admin.memo.titleHelp" />
                </div>

                <label>
                  <I18n k="admin.memo.subject" />
                  <textarea id="memoSubjectInput" rows="3" maxlength="500" {...placeholder("admin.memo.subjectPlaceholder")}></textarea>
                </label>

                <div class="form-row">
                  <label>
                    <I18n k="admin.memo.to" />
                    <textarea id="memoToInput" rows="3" maxlength="500" {...placeholder("admin.memo.toPlaceholder")}></textarea>
                  </label>
                  <label>
                    <I18n k="admin.memo.from" />
                    <textarea id="memoFromInput" rows="3" maxlength="500" {...placeholder("admin.memo.fromPlaceholder")}></textarea>
                  </label>
                </div>

                <label>
                  <I18n k="admin.memo.signature" />
                  <input id="memoSignatureInput" type="url" {...placeholder("admin.ph.publicPng")} />
                  <I18n class="field-help" k="admin.memo.signatureHelp" />
                </label>

                <div class="form-row">
                  <label>
                    <I18n k="admin.memo.signatoryName" />
                    <input id="memoSignatoryNameInput" type="text" maxlength="160" {...placeholder("admin.memo.signatoryNamePlaceholder")} />
                  </label>
                  <label>
                    <I18n k="admin.memo.signatoryPosition" />
                    <input id="memoSignatoryPositionInput" type="text" maxlength="180" {...placeholder("admin.memo.signatoryPositionPlaceholder")} />
                  </label>
                </div>
              </section>

              <label>
                <I18n k="admin.field.description" />
                <textarea id="descriptionInput" rows="3" maxlength="1200" {...placeholder("admin.field.descriptionPlaceholder")}></textarea>
              </label>

              <div id="contentFieldGroup" class="document-content-field hidden">
                {/* Label and placeholder text depend on the section; admin.js sets them. */}
                <label for="contentInput" id="contentFieldLabel"></label>

                <div class="formatting-toolbar" role="toolbar" {...ariaLabel("admin.fmt.toolbar")}>
                  <button type="button" class="format-button format-button-bold" data-document-format="bold" title="Bold (Ctrl+B)" {...ariaLabel("admin.fmt.bold")}><strong>B</strong></button>
                  <button type="button" class="format-button format-button-italic" data-document-format="italic" title="Italic (Ctrl+I)" {...ariaLabel("admin.fmt.italic")}><em>I</em></button>
                  <button type="button" class="format-button" data-document-format="heading" title={t("admin.fmt.headingTitle")} {...i18nAttr({ title: "admin.fmt.headingTitle" })} aria-label="Heading">H2</button>
                  <span class="formatting-divider" aria-hidden="true"></span>
                  <button type="button" class="format-button format-button-wide" data-document-format="bullet" title="Bullet list" aria-label="Bullet list"><I18n k="admin.fmt.bullet" /></button>
                  <button type="button" class="format-button format-button-wide" data-document-format="numbered" title="Numbered list" aria-label="Numbered list"><I18n k="admin.fmt.numbered" /></button>
                  <button type="button" class="format-button" data-document-format="quote" title={t("admin.fmt.quote")} {...i18nAttr({ title: "admin.fmt.quote", "aria-label": "admin.fmt.quote" })} aria-label={t("admin.fmt.quote")}>❝</button>
                  <button type="button" class="format-button" data-document-format="divider" title={t("admin.fmt.divider")} {...i18nAttr({ title: "admin.fmt.divider", "aria-label": "admin.fmt.divider" })} aria-label={t("admin.fmt.divider")}>―</button>
                </div>

                <textarea id="contentInput" rows="18" maxlength="45000" spellcheck="true"></textarea>

                <div class="document-format-help">
                  <I18n class="field-help" k="admin.content.help" />
                  <details>
                    <summary><I18n k="admin.fmt.guide" /></summary>
                    <div class="format-guide-grid">
                      <I18n as="code" k="admin.fmt.sample.bold" /><I18n k="admin.fmt.label.bold" />
                      <I18n as="code" k="admin.fmt.sample.italic" /><I18n k="admin.fmt.label.italic" />
                      <I18n as="code" k="admin.fmt.sample.boldItalic" /><I18n k="admin.fmt.label.boldItalic" />
                      <I18n as="code" k="admin.fmt.sample.heading" /><I18n k="admin.fmt.label.heading" />
                      <I18n as="code" k="admin.fmt.sample.bullet" /><I18n k="admin.fmt.label.bullet" />
                      <I18n as="code" k="admin.fmt.sample.numbered" /><I18n k="admin.fmt.label.numbered" />
                      <I18n as="code" k="admin.fmt.sample.quote" /><I18n k="admin.fmt.label.quote" />
                      <code>---</code><I18n k="admin.fmt.label.divider" />
                    </div>
                  </details>
                </div>
              </div>

              <div class="form-row">
                <label>
                  <span id="numberFieldLabel">{t("admin.number.label.default")}</span>
                  <input id="numberInput" type="text" maxlength="100" />
                </label>
                <label>
                  <I18n k="admin.field.date" />
                  <input id="dateInput" type="date" />
                </label>
              </div>

              <section id="autoNumberFields" class="entry-option-panel hidden">
                <label class="checkbox-label">
                  <input id="autoNumberInput" type="checkbox" checked />
                  <I18n k="admin.auto.label" />
                </label>
                <p class="field-help" id="autoNumberHelp">{t("admin.auto.help.default")}</p>
              </section>

              <section id="announcementPinFields" class="entry-option-panel pinned-option-panel hidden">
                <div class="admin-subsection-heading compact-heading">
                  <div>
                    <I18n as="span" class="eyebrow" k="admin.pin.eyebrow" />
                    <I18n as="h3" k="admin.pin.title" />
                  </div>
                  <I18n as="p" k="admin.pin.help" />
                </div>
                <label class="checkbox-label">
                  <input id="pinnedInput" type="checkbox" />
                  <I18n k="admin.pin.checkbox" />
                </label>
                <div class="form-row pin-detail-fields">
                  <label>
                    <I18n k="admin.pin.order" />
                    <input id="pinOrderInput" type="number" min="1" max="3" value="1" />
                    <I18n class="field-help" k="admin.pin.orderHelp" />
                  </label>
                  <label>
                    <I18n k="admin.pin.expires" />
                    <input id="pinExpiresInput" type="date" />
                    <I18n class="field-help" k="admin.pin.expiresHelp" />
                  </label>
                </div>
              </section>

              <label>
                <I18n k="admin.image.label" />
                <input id="imageInput" type="url" {...placeholder("admin.image.placeholder")} />
                <I18n class="field-help" k="admin.image.help" />
              </label>

              <label>
                External Link <span id="urlRequirementText">{t("admin.url.required")}</span>
                <input id="urlInput" type="url" placeholder="https://..." />
                <span class="field-help" id="urlHelpText">{t("admin.url.help.form")}</span>
              </label>

              <div class="form-row">
                <label>
                  <I18n k="admin.field.icon" />
                  <input id="iconInput" type="text" maxlength="12" placeholder="📄" />
                </label>
                <label>
                  <I18n k="admin.field.order" />
                  <input id="orderInput" type="number" min="0" value="0" />
                </label>
              </div>

              <label class="checkbox-label">
                <input id="publishedInput" type="checkbox" checked />
                <I18n k="admin.field.published" />
              </label>

              <button class="button button-primary" type="submit" id="saveButton">{t("admin.save")}</button>
            </form>
          </section>

          <section class="card admin-records" id="recordsPanel">
            <div class="admin-section-heading">
              <div>
                <I18n as="span" class="eyebrow" k="admin.records.eyebrow" />
                <h2 id="recordsTitle">{t(LABELS.Forms.plural)}</h2>
              </div>
              <button class="button button-secondary button-small" id="refreshButton" type="button"><I18n k="admin.refresh" /></button>
            </div>
            <p class="admin-warning hidden" id="pinWarning" role="status"></p>
            <div id="recordsList" class="records-list">
              <div class="loading-card">{t("admin.records.loading")}</div>
            </div>
          </section>

          <section class="card settings-editor hidden" id="settingsEditor">
            <div class="admin-section-heading">
              <div>
                <I18n as="span" class="eyebrow" k="admin.set.eyebrow" />
                <I18n as="h2" k="admin.set.title" />
              </div>
            </div>

            <form id="settingsForm" class="entry-form">
              <div class="form-row">
                <label>
                  <I18n k="admin.set.siteTitle" />
                  <input id="siteTitleInput" type="text" maxlength="100" />
                </label>
                <label>
                  <I18n k="admin.set.siteSubtitle" />
                  <input id="siteSubtitleInput" type="text" maxlength="140" />
                </label>
              </div>

              <label>
                <I18n k="admin.set.heroTitle" />
                <input id="heroTitleInput" type="text" maxlength="220" />
              </label>

              <label>
                <I18n k="admin.set.heroDescription" />
                <textarea id="heroDescriptionInput" rows="3" maxlength="700"></textarea>
              </label>

              <div class="settings-image-grid">
                <label>
                  <I18n k="admin.set.logo" />
                  <input id="logoUrlInput" type="url" {...placeholder("admin.ph.publicImage")} />
                  <I18n class="field-help" k="admin.set.logoHelp" />
                </label>
                <label>
                  <I18n k="admin.set.mayorImage" />
                  <input id="mayorImageUrlInput" type="url" {...placeholder("admin.ph.publicImage")} />
                  <I18n class="field-help" k="admin.set.mayorImageHelp" />
                </label>
                <label>
                  <I18n k="admin.set.heroImage" />
                  <input id="heroImageUrlInput" type="url" {...placeholder("admin.ph.publicImage")} />
                  <I18n class="field-help" k="admin.set.heroImageHelp" />
                </label>
                <label>
                  <I18n k="admin.set.docImage" />
                  <input id="defaultDocumentImageUrlInput" type="url" {...placeholder("admin.ph.publicImage")} />
                  <I18n class="field-help" k="admin.set.docImageHelp" />
                </label>
              </div>

              <label>
                <I18n k="admin.set.mayorName" />
                <input id="mayorNameInput" type="text" maxlength="120" />
              </label>

              <section class="memorandum-default-settings" aria-labelledby="memorandumDefaultsTitle">
                <div class="admin-subsection-heading">
                  <div>
                    <I18n as="span" class="eyebrow" k="admin.set.memoEyebrow" />
                    <I18n as="h3" id="memorandumDefaultsTitle" k="admin.set.memoTitle" />
                  </div>
                  <I18n as="p" k="admin.set.memoHelp" />
                </div>

                <label>
                  <I18n k="admin.set.signature" />
                  <input id="defaultSignatureImageUrlInput" type="url" {...placeholder("admin.ph.publicPng")} />
                </label>

                <div class="form-row">
                  <label>
                    <I18n k="admin.set.signatoryName" />
                    <input id="defaultSignatoryNameInput" type="text" maxlength="160" placeholder="Alejandro Tagalog" />
                  </label>
                  <label>
                    <I18n k="admin.set.signatoryPosition" />
                    <input id="defaultSignatoryPositionInput" type="text" maxlength="180" {...placeholder("settings.defaultSignatoryPosition")} />
                  </label>
                </div>
              </section>

              <div class="form-row">
                <label>
                  <I18n k="admin.set.meetingLabel" />
                  <input id="meetingButtonLabelInput" type="text" maxlength="80" {...placeholder("settings.meetingButtonLabel")} />
                </label>
                <label>
                  <span>Google Calendar Booking Link</span>
                  <input id="meetingUrlInput" type="url" placeholder="https://calendar.google.com/calendar/appointments/..." />
                  <I18n class="field-help" k="admin.set.meetingUrlHelp" />
                </label>
              </div>

              <label>
                <I18n k="admin.set.footerText" />
                <input id="footerTextInput" type="text" maxlength="220" />
              </label>

              <button class="button button-primary" id="saveSettingsButton" type="submit">{t("admin.set.save")}</button>
            </form>
          </section>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer admin-footer">
    <div class="container footer-inner">
      <LanguageSelect />
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import "../scripts/language.ts";
      import "./admin.js";
    </script>
  </body>
</html>
