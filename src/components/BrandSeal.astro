---
import { i18nAttr, t } from "../lib/i18n";
import { imageSourceUrl } from "../lib/format";

/**
 * The round seal in the header/footer: the uploaded logo, else "LS". The page's
 * script (scripts/egov-page.ts) swaps it for the live setting's, with the same
 * markup from lib/render.ts (brandSeal): keep the two alike.
 */
interface Props {
  logoUrl: string;
  alt?: string;
}

const { logoUrl, alt } = Astro.props;
const logo = imageSourceUrl(logoUrl);
---

{
  logo ? (
    <span class="brand-seal has-image" data-brand-seal aria-hidden="true"><img src={logo} alt={alt ?? t("brand.sealAlt")} {...(alt ? {} : i18nAttr({ alt: "brand.sealAlt" }))} /></span>
  ) : (
    <span class="brand-seal" data-brand-seal aria-hidden="true">LS</span>
  )
}
