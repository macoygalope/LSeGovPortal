---
import { isKiosk } from "../lib/kiosk";
import { safeUrl } from "../lib/format";
import { i18n, t, type MessageKey } from "../lib/i18n";

/**
 * A link out to an external site (Google Form, booking calendar, signed
 * copy). On the kiosk build it renders a disabled placeholder instead, since
 * the kiosk screen can't be assumed to open external sites; built-in forms
 * will replace these later.
 */
interface Props {
  url: string;
  /** Text written by staff (e.g. a custom button label); shown as written. */
  label?: string;
  /** Interface text that follows the chosen language. Wins over `label`. */
  labelKey?: MessageKey;
  /** "link" = plain text link (cards); "primary"/"secondary" = buttons. */
  variant?: "link" | "primary" | "secondary";
  /** What the disabled kiosk placeholder says. */
  placeholderKey?: MessageKey;
  id?: string;
}

const { url, label = "", labelKey, variant = "link", placeholderKey = "kiosk.unavailable", id } = Astro.props;
const href = safeUrl(url);
const buttonClass = variant === "link" ? "" : `button button-${variant}`;
const text = labelKey ? t(labelKey) : label;
const textAttrs = labelKey ? i18n(labelKey) : {};
const placeholder = t(placeholderKey);
const placeholderAttrs = i18n(placeholderKey);
---

{
  href &&
    (isKiosk ? (
      variant === "link" ? (
        <span class="external-placeholder" id={id} {...placeholderAttrs}>{placeholder}</span>
      ) : (
        <span class={`${buttonClass} is-disabled`} id={id} aria-disabled="true" {...placeholderAttrs}>{placeholder}</span>
      )
    ) : (
      <a class={buttonClass || undefined} id={id} href={href} target="_blank" rel="noopener noreferrer" {...textAttrs}>{text}</a>
    ))
}
