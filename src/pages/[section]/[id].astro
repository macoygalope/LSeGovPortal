---
import type { GetStaticPaths } from "astro";
import Layout from "../../components/Layout.astro";
import ExternalAction from "../../components/ExternalAction.astro";
import { getEgovData } from "../../lib/data";
import { dateAttrs, formatDate, formatMemoDate } from "../../lib/format";
import { i18n, i18nAttr, settingI18n, t, type MessageKey } from "../../lib/i18n";
import { resolveImage } from "../../lib/images";
import { isKiosk } from "../../lib/kiosk";
import { documentContentToHtml } from "../../lib/markdown";
import { LABELS, SECTION_ROUTE } from "../../lib/sections";
import { withBase } from "../../lib/url";
import { DOCUMENT_SECTIONS, type DocumentSection, type EgovRecord } from "../../lib/types";

// A page exists only for records that have body text. Records with just an
// external link keep linking out from their card instead.
export const getStaticPaths = (async () => {
  const { sections } = await getEgovData();
  return DOCUMENT_SECTIONS.flatMap((section) =>
    sections[section]
      .filter((item) => item.content !== "")
      .map((item) => ({
        params: { section: SECTION_ROUTE[section], id: item.id },
        props: { section, item },
      })),
  );
}) satisfies GetStaticPaths;

interface Props {
  section: DocumentSection;
  item: EgovRecord;
}

const { section, item } = Astro.props;
const { settings } = await getEgovData();
const label = LABELS[section];
const isMemo = section === "Memorandums";
const archiveHref = withBase(`/${SECTION_ROUTE[section]}/`);
const body = documentContentToHtml(item.content, { links: !isKiosk });

const cover = await resolveImage(item.image || settings.defaultDocumentImageUrl, 1200);

// Memorandum-only: the global "default document image" is the letterhead for
// every memorandum, and the signature falls back to the site-wide default.
const letterhead = isMemo ? await resolveImage(settings.defaultDocumentImageUrl, 1200) : "";
const signature = isMemo ? await resolveImage(item.signatureImage || settings.defaultSignatureImageUrl, 480) : "";
const signatoryName = item.signatoryName || settings.defaultSignatoryName || settings.mayorName;
const signatoryPosition = item.signatoryPosition || settings.defaultSignatoryPosition;

// Titles and descriptions written by staff are shown as written; only the
// fallbacks used when they're missing follow the chosen language.
const pageTitle = isMemo ? item.number : item.title;
const pageTitleKey = pageTitle ? undefined : label.singular;

// Each memorandum header line: the value staff entered, else a default.
const memoRows = [
  { label: "memo.to", value: item.memoTo, fallback: "memo.toDefault" },
  { label: "memo.from", value: item.memoFrom, fallback: "memo.fromDefault" },
  { label: "memo.subject", value: item.subject || item.title, fallback: "section.Memorandums.singular" },
] as const satisfies { label: MessageKey; value: string; fallback: MessageKey }[];
---

<Layout
  title={pageTitle || undefined}
  titleKey={pageTitleKey}
  description={item.description || undefined}
  descriptionKey={label.defaultDescription}
  settings={settings}
  noindex={isMemo}
  bodyClass="memorandum-detail-body"
>
  <main class="memorandum-detail-main">
    <div class="container memorandum-toolbar">
      <a class="button button-secondary button-small" href={archiveHref} {...i18n(label.back)}>{t(label.back)}</a>
      <div class="memorandum-toolbar-actions">
        <ExternalAction url={item.url} labelKey={label.externalAction} variant="secondary" />
        {
          !isKiosk && (
            <button class="button button-primary button-small" type="button" data-print {...i18n("doc.print")}>
              {t("doc.print")}
            </button>
          )
        }
      </div>
    </div>

    <section class="memorandum-reader-stage">
      {
        isMemo ? (
          <article class="official-document memorandum-document">
            {letterhead && (
              <img
                class="memorandum-letterhead"
                src={letterhead}
                alt={t("memo.letterheadAlt")}
                {...i18nAttr({ alt: "memo.letterheadAlt" })}
              />
            )}

            <header class="memorandum-heading">
              <span class="eyebrow" {...i18n("memo.eyebrow")}>{t("memo.eyebrow")}</span>
              <h1>{item.number || "MEMORANDUM"}</h1>
            </header>

            <div
              class="memorandum-meta"
              aria-label={t("memo.detailsAria")}
              {...i18nAttr({ "aria-label": "memo.detailsAria" })}
            >
              {memoRows.map((row) => (
                <div class="memorandum-meta-row">
                  <span class="memorandum-meta-label" {...i18n(row.label)}>{t(row.label)}</span>
                  <span class="memorandum-meta-colon">:</span>
                  <strong {...(row.value ? {} : i18n(row.fallback))}>{row.value || t(row.fallback)}</strong>
                </div>
              ))}
              <div class="memorandum-meta-row">
                <span class="memorandum-meta-label" {...i18n("memo.date")}>{t("memo.date")}</span>
                <span class="memorandum-meta-colon">:</span>
                <strong {...dateAttrs(item.date, "memo")}>{formatMemoDate(item.date)}</strong>
              </div>
            </div>

            <div class="memorandum-body official-document-body" set:html={body} />

            <footer class="memorandum-document-footer">
              <div class="memorandum-signature-block">
                {
                  signature && (
                    <img
                      class="memorandum-signature-image"
                      src={signature}
                      alt={t("memo.signatureAlt")}
                      {...i18nAttr({ alt: "memo.signatureAlt" })}
                    />
                  )
                }
                <strong class="memorandum-signatory-name">{signatoryName}</strong>
                <span
                  class="memorandum-signatory-position"
                  {...(item.signatoryPosition ? {} : settingI18n("defaultSignatoryPosition", signatoryPosition))}
                >
                  {signatoryPosition}
                </span>
              </div>
            </footer>
          </article>
        ) : (
          <article class="official-document memorandum-document">
            {cover && <img class="official-document-cover" src={cover} alt="" />}
            <div class="official-document-heading">
              <span class="eyebrow" {...(item.number ? {} : i18n(label.singular))}>
                {item.number || t(label.singular)}
              </span>
              <h2>{item.title}</h2>
              <p {...dateAttrs(item.date)}>{formatDate(item.date)}</p>
            </div>
            <div class="official-document-body" set:html={body} />
            <div class="official-document-footer">
              <p>
                <span {...i18n("home.mayorOffice")}>{t("home.mayorOffice")}</span><br />
                <strong>{settings.mayorName}</strong>
              </p>
            </div>
          </article>
        )
      }
    </section>
  </main>

  <script>
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  </script>
</Layout>
