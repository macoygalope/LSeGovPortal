---
import Layout from "../components/Layout.astro";
import CardMedia from "../components/CardMedia.astro";
import DocumentCard from "../components/DocumentCard.astro";
import ExternalAction from "../components/ExternalAction.astro";
import FormViewer from "../components/FormViewer.astro";
import { getEgovData } from "../lib/data";
import { byAdminOrder, localTodayIso, orderedAnnouncements, sortDocuments } from "../lib/documents";
import { i18n, i18nAttr, settingI18n, settingKey, t, type MessageKey } from "../lib/i18n";
import { resolveImage } from "../lib/images";
import { ARCHIVE_COPY, LABELS } from "../lib/sections";
import { withBase } from "../lib/url";

const { settings, sections } = await getEgovData();

const forms = [...sections.Forms].sort(byAdminOrder);
const announcements = orderedAnnouncements(sections.Announcements, localTodayIso()).slice(0, 3);
const executiveOrders = sortDocuments(sections.ExecutiveOrders).slice(0, 3);
const resolutions = sortDocuments(sections.Resolutions).slice(0, 3);

const heroImage = await resolveImage(settings.heroImageUrl, 1600);
const mayorImage = await resolveImage(settings.mayorImageUrl, 640);

const stats: { id: string; count: number; label: MessageKey }[] = [
  { id: "formsCount", count: sections.Forms.length, label: "home.stat.forms" },
  { id: "announcementCount", count: sections.Announcements.length, label: LABELS.Announcements.plural },
  { id: "ordersCount", count: sections.ExecutiveOrders.length, label: LABELS.ExecutiveOrders.plural },
  { id: "documentsCount", count: sections.Resolutions.length, label: LABELS.Resolutions.plural },
];
---

<Layout settings={settings}>
  <main id="top">
    <section
      class:list={["hero", { "has-custom-image": heroImage }]}
      id="heroSection"
      style={heroImage ? `--hero-image: url("${heroImage}")` : undefined}
    >
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow" {...i18n("home.eyebrow")}>{t("home.eyebrow")}</span>
          <h1 {...settingI18n("heroTitle", settings.heroTitle)}>{settings.heroTitle}</h1>
          <p {...settingI18n("heroDescription", settings.heroDescription)}>{settings.heroDescription}</p>
          <div class="hero-actions">
            <ExternalAction
              url={settings.meetingUrl}
              label={settings.meetingButtonLabel}
              labelKey={settingKey("meetingButtonLabel", settings.meetingButtonLabel)}
              variant="primary"
            />
            <a class="button button-secondary" href="#announcements" {...i18n("home.viewAnnouncements")}>
              {t("home.viewAnnouncements")}
            </a>
          </div>
        </div>

        <aside class="hero-panel">
          <div class="mayor-photo-wrap">
            {
              mayorImage ? (
                <img
                  id="mayorImage"
                  class="mayor-photo"
                  src={mayorImage}
                  alt={t("home.mayorAlt")}
                  {...i18nAttr({ alt: "home.mayorAlt" })}
                />
              ) : (
                <div class="hero-panel-icon">🏛️</div>
              )
            }
          </div>
          <p class="hero-panel-label" {...i18n("home.mayorOffice")}>{t("home.mayorOffice")}</p>
          <h2>{settings.mayorName}</h2>
          <p {...i18n("home.motto")}>{t("home.motto")}</p>
          <div class="status-pill"><span></span> <span {...i18n("home.status")}>{t("home.status")}</span></div>
        </aside>
      </div>
    </section>

    <section class="quick-stats">
      <div class="container stats-grid">
        {
          stats.map((stat) => (
            <div>
              <strong id={stat.id}>{stat.count}</strong>
              <span {...i18n(stat.label)}>{t(stat.label)}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="forms">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow" {...i18n("home.forms.eyebrow")}>{t("home.forms.eyebrow")}</span>
            <h2 {...i18n("home.forms.title")}>{t("home.forms.title")}</h2>
          </div>
          <p {...i18n("home.forms.intro")}>{t("home.forms.intro")}</p>
        </div>
        <div class="forms-grid" id="formsGrid">
          {
            forms.length ? (
              forms.map((form) => (
                <button
                  class="form-card form-card-button"
                  type="button"
                  data-open-form
                  data-id={form.id}
                  aria-label={t("home.forms.cardAria", { title: form.title })}
                  {...i18nAttr({ "aria-label": "home.forms.cardAria" }, { title: form.title })}
                >
                  <CardMedia image={form.image} icon={form.icon} />
                  <div class="form-card-body">
                    <h3>{form.title}</h3>
                    <p {...(form.description ? {} : i18n("home.forms.cardDefault"))}>
                      {form.description || t("home.forms.cardDefault")}
                    </p>
                    <span class="card-link" {...i18n(LABELS.Forms.readAction)}>{t(LABELS.Forms.readAction)}</span>
                  </div>
                </button>
              ))
            ) : (
              <div class="empty-state" {...i18n("home.forms.empty")}>{t("home.forms.empty")}</div>
            )
          }
        </div>
      </div>
    </section>

    <section class="section section-muted document-section" id="announcements">
      <div class="container">
        <div class="section-heading section-heading-actions">
          <div>
            <span class="eyebrow" {...i18n(ARCHIVE_COPY.Announcements.eyebrow)}>
              {t(ARCHIVE_COPY.Announcements.eyebrow)}
            </span>
            <h2 {...i18n(LABELS.Announcements.plural)}>{t(LABELS.Announcements.plural)}</h2>
            <p {...i18n("home.announcements.intro")}>{t("home.announcements.intro")}</p>
          </div>
          <a class="button button-secondary" href={withBase("/announcements/")} {...i18n("home.viewAll")}>
            {t("home.viewAll")}
          </a>
        </div>
        <div class="document-grid" id="announcementGrid">
          {
            announcements.length ? (
              announcements.map(({ item, pinned }) => (
                <DocumentCard item={item} section="Announcements" pinned={pinned} />
              ))
            ) : (
              <div class="empty-state" {...i18n(LABELS.Announcements.empty)}>
                {t(LABELS.Announcements.empty)}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="section document-section" id="executive-orders">
      <div class="container">
        <div class="section-heading section-heading-actions">
          <div>
            <span class="eyebrow" {...i18n(ARCHIVE_COPY.ExecutiveOrders.eyebrow)}>
              {t(ARCHIVE_COPY.ExecutiveOrders.eyebrow)}
            </span>
            <h2 {...i18n(LABELS.ExecutiveOrders.plural)}>{t(LABELS.ExecutiveOrders.plural)}</h2>
            <p {...i18n(ARCHIVE_COPY.ExecutiveOrders.intro)}>{t(ARCHIVE_COPY.ExecutiveOrders.intro)}</p>
          </div>
          <a class="button button-secondary" href={withBase("/executive-orders/")} {...i18n("home.viewAll")}>
            {t("home.viewAll")}
          </a>
        </div>
        <div class="document-grid" id="executiveGrid">
          {
            executiveOrders.length ? (
              executiveOrders.map((item) => (
                <DocumentCard item={item} section="ExecutiveOrders" fallbackImage={settings.defaultDocumentImageUrl} />
              ))
            ) : (
              <div class="empty-state" {...i18n(LABELS.ExecutiveOrders.empty)}>
                {t(LABELS.ExecutiveOrders.empty)}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="section document-section" id="resolutions">
      <div class="container">
        <div class="section-heading section-heading-actions">
          <div>
            <span class="eyebrow" {...i18n(ARCHIVE_COPY.Resolutions.eyebrow)}>
              {t(ARCHIVE_COPY.Resolutions.eyebrow)}
            </span>
            <h2 {...i18n(LABELS.Resolutions.plural)}>{t(LABELS.Resolutions.plural)}</h2>
            <p {...i18n(ARCHIVE_COPY.Resolutions.intro)}>{t(ARCHIVE_COPY.Resolutions.intro)}</p>
          </div>
          <a class="button button-secondary" href={withBase("/resolutions/")} {...i18n("home.viewAll")}>
            {t("home.viewAll")}
          </a>
        </div>
        <div class="document-grid" id="resolutionGrid">
          {
            resolutions.length ? (
              resolutions.map((item) => (
                <DocumentCard item={item} section="Resolutions" fallbackImage={settings.defaultDocumentImageUrl} />
              ))
            ) : (
              <div class="empty-state" {...i18n(LABELS.Resolutions.empty)}>
                {t(LABELS.Resolutions.empty)}
              </div>
            )
          }
        </div>
      </div>
    </section>
  </main>

  <FormViewer forms={forms} settings={settings} />
</Layout>
