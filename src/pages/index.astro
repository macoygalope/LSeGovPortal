---
import Layout from "../components/Layout.astro";
import FormViewer from "../components/FormViewer.astro";
import LoadStatus from "../components/LoadStatus.astro";
import { i18n, settingI18n, settingKey, t, type MessageKey } from "../lib/i18n";
import { isKiosk } from "../lib/kiosk";
import { externalAction, heroImageStyle, mayorPhoto } from "../lib/render";
import { ARCHIVE_COPY, LABELS } from "../lib/sections";
import { getBuildSettings } from "../lib/snapshot";
import { withBase } from "../lib/url";

// The frame of the home page: the headings and the hero. Its forms, its latest
// documents and the numbers under the hero are put in by scripts/egov-page.ts
// once the content is in (lib/render.ts, renderHome); the settings-driven parts
// start from the settings this build was made with and are replaced by the
// live ones.
const settings = await getBuildSettings();
const ctx = { base: import.meta.env.BASE_URL, kiosk: isKiosk };
const heroStyle = heroImageStyle(settings.heroImageUrl);

const stats: { id: string; label: MessageKey }[] = [
  { id: "formsCount", label: "home.stat.forms" },
  { id: "announcementCount", label: LABELS.Announcements.plural },
  { id: "ordersCount", label: LABELS.ExecutiveOrders.plural },
  { id: "documentsCount", label: LABELS.Resolutions.plural },
];

const documentSections = [
  { id: "announcements", grid: "announcementGrid", route: "/announcements/", section: "Announcements", muted: true },
  { id: "executive-orders", grid: "executiveGrid", route: "/executive-orders/", section: "ExecutiveOrders", muted: false },
  { id: "resolutions", grid: "resolutionGrid", route: "/resolutions/", section: "Resolutions", muted: false },
] as const;
---

<Layout settings={settings} page="home">
  <main id="top">
    <section class:list={["hero", { "has-custom-image": heroStyle }]} id="heroSection" style={heroStyle || undefined}>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow" {...i18n("home.eyebrow")}>{t("home.eyebrow")}</span>
          <h1 data-hero-title {...settingI18n("heroTitle", settings.heroTitle)}>{settings.heroTitle}</h1>
          <p data-hero-description {...settingI18n("heroDescription", settings.heroDescription)}>{settings.heroDescription}</p>
          <div class="hero-actions">
            <span
              data-meeting-action
              style="display: contents"
              set:html={externalAction(ctx, {
                url: settings.meetingUrl,
                label: settings.meetingButtonLabel,
                labelKey: settingKey("meetingButtonLabel", settings.meetingButtonLabel),
                variant: "primary",
              })}
            />
            <a class="button button-secondary" href="#announcements" {...i18n("home.viewAnnouncements")}>
              {t("home.viewAnnouncements")}
            </a>
          </div>
        </div>

        <aside class="hero-panel">
          <div class="mayor-photo-wrap" data-mayor-photo set:html={mayorPhoto(settings.mayorImageUrl)} />
          <p class="hero-panel-label" {...i18n("home.mayorOffice")}>{t("home.mayorOffice")}</p>
          <h2 data-mayor-name>{settings.mayorName}</h2>
          <p {...i18n("home.motto")}>{t("home.motto")}</p>
          <div class="status-pill"><span></span> <span {...i18n("home.status")}>{t("home.status")}</span></div>
        </aside>
      </div>
    </section>

    <LoadStatus />

    <section class="quick-stats">
      <div class="container stats-grid">
        {
          stats.map((stat) => (
            <div>
              <strong id={stat.id}>–</strong>
              <span {...i18n(stat.label)}>{t(stat.label)}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="forms">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow" {...i18n("home.forms.eyebrow")}>{t("home.forms.eyebrow")}</span>
            <h2 {...i18n("home.forms.title")}>{t("home.forms.title")}</h2>
          </div>
          <p {...i18n("home.forms.intro")}>{t("home.forms.intro")}</p>
        </div>
        <div class="forms-grid" id="formsGrid"></div>
      </div>
    </section>

    {
      documentSections.map(({ id, grid, route, section, muted }) => (
        <section class:list={["section", { "section-muted": muted }, "document-section"]} id={id}>
          <div class="container">
            <div class="section-heading section-heading-actions">
              <div>
                <span class="eyebrow" {...i18n(ARCHIVE_COPY[section].eyebrow)}>{t(ARCHIVE_COPY[section].eyebrow)}</span>
                <h2 {...i18n(LABELS[section].plural)}>{t(LABELS[section].plural)}</h2>
                <p {...i18n(section === "Announcements" ? "home.announcements.intro" : ARCHIVE_COPY[section].intro)}>
                  {t(section === "Announcements" ? "home.announcements.intro" : ARCHIVE_COPY[section].intro)}
                </p>
              </div>
              <a class="button button-secondary" href={withBase(route)} {...i18n("home.viewAll")}>
                {t("home.viewAll")}
              </a>
            </div>
            <div class="document-grid" id={grid}></div>
          </div>
        </section>
      ))
    }
  </main>

  <FormViewer settings={settings} />
</Layout>
