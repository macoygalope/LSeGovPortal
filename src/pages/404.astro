---
import Layout from "../components/Layout.astro";
import { getEgovData } from "../lib/data";
import { withBase } from "../lib/url";

const { settings } = await getEgovData();
---

<Layout title="Hindi Makita ang Pahina" settings={settings} noindex>
  <main class="section">
    <div class="container">
      <div class="error-state">
        Hindi makita ang pahinang iyong hinahanap.
        <p><a class="button button-secondary" href={withBase("/")}>← Bumalik sa Unang Pahina</a></p>
      </div>
    </div>
  </main>
</Layout>
