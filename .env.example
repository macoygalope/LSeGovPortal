# Nothing here is required. A build reads data/egov.db (create it with
# `npm run db:import -- --file fixtures/live-all.json`).

# Optional: build from a saved response instead of the database, e.g.
#   EGOV_DATA_FILE=fixtures/live-all.json
# EGOV_DATA_FILE=

# Optional: use another SQLite file. The db:* commands default to this path
# (else data/egov.db), and so does a build.
# EGOV_DB_FILE=

# Optional: the login token for the admin dashboard (`npm run admin`), 16
# characters or more. Without it a new one is printed each time it starts.
# EGOV_ADMIN_TOKEN=

# Kiosk build only: lspd-backend's origin, used to look up the citizen who is
# using the kiosk (the fingerprint scan in a form's pop-out), e.g.
#   PUBLIC_LSPD_API_URL=http://localhost:8080
# Inlined into the build, so set it before `npm run build:kiosk`.
# PUBLIC_LSPD_API_URL=
