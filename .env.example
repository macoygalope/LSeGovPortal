# Google Apps Script web app URL (the /exec URL). Public by design: the build
# reads published content from it, and /admin (non-kiosk build only) calls it
# from the browser with the admin token.
PUBLIC_EGOV_API_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Optional: build from a saved response instead of the live backend, e.g.
#   EGOV_DATA_FILE=fixtures/live-all.json
# EGOV_DATA_FILE=

# Optional: the local SQLite copy of the sheet (create it with
# `npm run db:import`). The db:* commands default to this path (else
# data/egov.db); a build reads it when it is set in the shell, e.g.
#   EGOV_DB_FILE=data/egov.db npm run build:kiosk
# EGOV_DB_FILE=
