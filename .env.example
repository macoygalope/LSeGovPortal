# Nothing here is required. A build reads data/egov.db (create it with
# `npm run db:import -- --file fixtures/live-all.json`).

# Optional: build from a saved response instead of the database, e.g.
#   EGOV_DATA_FILE=fixtures/live-all.json
# EGOV_DATA_FILE=

# Optional: use another SQLite file. The db:* commands default to this path
# (else data/egov.db), and so does a build. In development this can be
# lspd-backend's data/sites/egov/site.db, so the dashboard edits what that
# server reads (it can only reach the public_* views); see the README.
# EGOV_DB_FILE=

# Kiosk build only: lspd-backend's origin, used to look up the citizen who is
# using the kiosk (the fingerprint scan in a form's pop-out), e.g.
#   PUBLIC_LSPD_API_URL=http://localhost:8080
# Inlined into the build, so set it before `npm run build:kiosk`.
# PUBLIC_LSPD_API_URL=

# `npm run deploy` (puts the site on a server over SSH; see the README's "Deploying to a
# server"). `npm run deploy -- check staging` tests these step by step.
# The server, as ssh takes it: user@host, or a Host alias from ~/.ssh/config.
# DEPLOY_SSH_HOST=deploy@203.0.113.7
# DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# The folder on the server that holds deploy-site.ps1 and the lspd-backend env files
# (prestige-nginx/deploy/windows), and a folder bundles are uploaded to (it must exist).
# Forward slashes; letters, digits, spaces and _ . ( ) - only.
# DEPLOY_REMOTE_SCRIPTS=C:/prestige-nginx/deploy/windows
# DEPLOY_REMOTE_DROP=D:/deploy-drop

# Development only (`npm run admin`, `npm run dev`): a citizen to treat as
# using the site when the browser has none, so the admin dashboard signs them
# in without the game. They still have to be on the admin list:
#   npm run admins -- add TST00001 "Mock Test Admin"
# Ignored by every build. Leave it unset anywhere real people use the dashboard.
# PUBLIC_MOCK_CITIZEN_ID=TST00001
